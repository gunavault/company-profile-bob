# Turso (libSQL) – buat database di https://turso.tech lalu isi:
TURSO_DATABASE_URL=libsql://nama-db-anda.turso.io
TURSO_AUTH_TOKEN=

# Vercel Blob – otomatis terisi setelah Blob Store dihubungkan ke project Vercel
BLOB_READ_WRITE_TOKEN=

# String acak panjang untuk menandatangani cookie login admin
AUTH_SECRET=

# URL produksi (dipakai untuk sitemap.xml & meta tag)
SITE_URL=https://grccetak.id
